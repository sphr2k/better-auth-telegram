{
  "name": "better-auth-telegram",
  "version": "2.1.0-sphr2k.1",
  "type": "module",
  "description": "Telegram authentication plugin for Better Auth 1.7 (sphr2k fork)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "bunx ultracite check",
    "lint:fix": "bunx ultracite fix",
    "prepublishOnly": "bun run type-check && bun run test && bun run build"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "telegram",
    "telegram-login",
    "telegram-mini-apps",
    "authentication",
    "oauth",
    "plugin",
    "typescript"
  ],
  "author": "Vibe Code <hello@vcode.sh> (https://vcode.sh)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sphr2k/better-auth-telegram.git"
  },
  "bugs": {
    "url": "https://github.com/sphr2k/better-auth-telegram/issues"
  },
  "homepage": "https://github.com/sphr2k/better-auth-telegram#readme",
  "peerDependencies": {
    "better-auth": ">=1.7.12 <1.8.0",
    "@better-auth/core": ">=1.7.12 <1.8.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "better-auth": "1.7.12",
    "happy-dom": "20.11.1",
    "lint-staged": "17.2.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "ultracite": "7.5.9",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "bunx ultracite fix"
    ]
  },
  "dependencies": {
    "@better-fetch/fetch": "1.3.2",
    "jose": "^6.2.3"
  }
}
